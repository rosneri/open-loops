// Persistence mirrors the aggregates, not the screens. Everything time-like is a DateTime here
// and an epoch-millisecond `Instant` in the domain; src/mappers is the only place that converts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // Prisma 7 takes the connection string from prisma.config.ts (CLI) and from the driver
  // adapter passed to `new PrismaClient()` (runtime). Nothing secret lives in this file.
  provider = "postgresql"
}

model OpenLoop {
  id        String @id
  /// Every root table carries its owner. The child tables below do not: they are reachable
  /// only through a parent that already has one, and a second copy could disagree with it.
  ownerId   String
  sourceKey String

  kind    String
  title   String
  summary String @db.Text

  provider   String
  externalId String
  threadRef  String?
  url        String?
  channel    String?
  occurredAt DateTime

  counterpartyName       String?
  counterpartyHandle     String?
  counterpartyEmail      String?
  counterpartyImportance String?

  dueAt           DateTime?
  promisedFor     DateTime?
  estimateMinutes Int
  priority        Int
  confidence      Float

  manualState  String?
  manualReason String?
  snoozedUntil DateTime?

  createdAt     DateTime
  updatedAt     DateTime
  lastCheckedAt DateTime?

  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  criteria   Criterion[]
  evidence   EvidenceRecord[]
  planBlocks PlanBlock[]
  events     LoopEventLog[]

  @@unique([ownerId, sourceKey])
  @@index([ownerId, updatedAt])
  @@index([ownerId, provider])
}

model Criterion {
  id       String  @id
  loopId   String
  role     String
  optional Boolean @default(false)
  probe    Json

  loop     OpenLoop         @relation(fields: [loopId], references: [id], onDelete: Cascade)
  evidence EvidenceRecord[]

  @@index([loopId])
}

model EvidenceRecord {
  id          String   @id @default(uuid())
  loopId      String
  criterionId String
  verdict     String
  observedAt  DateTime
  summary     String   @db.Text
  url         String?

  loop      OpenLoop  @relation(fields: [loopId], references: [id], onDelete: Cascade)
  criterion Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  /// Two identical observations of the same criterion at the same instant are the same
  /// observation. Making that a database fact lets the aggregate be written with an idempotent
  /// `createMany` instead of a read-then-append inside an interactive transaction.
  @@unique([criterionId, observedAt, verdict])
  @@index([loopId, observedAt])
}

model DailyPlan {
  id          String   @id
  ownerId     String
  day         String
  dayStartAt  DateTime
  startMinute Int
  endMinute   Int
  manualOrder Json
  generatedAt DateTime

  owner  User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  blocks PlanBlock[]

  @@unique([ownerId, day])
}

model PlanBlock {
  id          String   @id @default(uuid())
  planId      String
  loopId      String
  startAt     DateTime
  endAt       DateTime
  position    Int
  disposition String
  slipCount   Int      @default(0)
  pinned      Boolean  @default(false)

  plan DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  loop OpenLoop  @relation(fields: [loopId], references: [id], onDelete: Cascade)

  @@unique([planId, loopId])
  @@index([planId, startAt])
}

model Integration {
  id                 String    @id
  ownerId            String
  provider           String
  mode               String
  status             String
  accountLabel       String?
  externalAccountRef String?
  scopes             String[]
  lastSyncedAt       DateTime?
  lastError          String?
  connectedAt        DateTime?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, provider])
}

model SyncCursor {
  ownerId  String
  provider String
  at       DateTime

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([ownerId, provider])
}

model RawSignal {
  id             String    @id @default(uuid())
  ownerId        String
  provider       String
  externalId     String
  kind           String
  title          String    @db.Text
  body           String    @db.Text
  author         Json
  participants   Json
  occurredAt     DateTime
  threadRef      String?
  url            String?
  channel        String?
  isDirectedAtMe Boolean   @default(false)
  metadata       Json?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, provider, externalId])
  @@index([ownerId, processedAt, occurredAt])
  @@index([ownerId, kind, occurredAt])
}

model LoopEventLog {
  id      String   @id @default(uuid())
  loopId  String
  type    String
  at      DateTime
  payload Json

  loop OpenLoop @relation(fields: [loopId], references: [id], onDelete: Cascade)

  @@index([loopId, at])
}

/// Local mode has no API keys, so the AI client answers probes out of band. A tick leaves the
/// question here; the agent posts the answer back and the next tick consumes it exactly once.
model ProbeTask {
  id          String    @id @default(uuid())
  ownerId     String
  loopId      String
  criterionId String
  probe       Json
  describedAs String    @db.Text
  requestedAt DateTime  @default(now())
  answeredAt  DateTime?
  consumedAt  DateTime?
  verdict     String?
  summary     String?   @db.Text
  url         String?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, criterionId, answeredAt])
  @@index([ownerId, answeredAt, consumedAt])
}

/// The only account model this app has. Credentials never live in environment variables, so a
/// password change is a row update rather than a redeploy. `passwordHash` is scrypt output with
/// its own salt and parameters encoded in the string; nothing here is reversible.
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Bumping this invalidates every token issued before the change, which is what makes
  /// "log out everywhere" and a password reset the same operation.
  tokenVersion Int      @default(0)

  settings     UserSettings?
  loops        OpenLoop[]
  plans        DailyPlan[]
  integrations Integration[]
  cursors      SyncCursor[]
  signals      RawSignal[]
  probeTasks   ProbeTask[]
  episodes     PodcastEpisode[]
}

/// One row per person. Settings that someone changes from the app belong in the database rather
/// than in environment variables — changing a schedule should not be a redeploy. The env vars
/// remain the seed for a new row and nothing more.
model UserSettings {
  id     String @id @default(uuid())
  userId String @unique

  /// Cron expressions, read in OPEN_LOOPS_TIMEZONE.
  sweepCron   String
  podcastCron String

  podcastEnabled     Boolean @default(false)
  podcastLength      String  @default("default")
  podcastHostVoiceId  String?
  podcastGuestVoiceId String?

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One episode per day. `brief` is the text the generator was given, kept because a disappointing
/// episode is almost always a disappointing brief.
model PodcastEpisode {
  id      String @id @default(uuid())
  ownerId String
  day     String
  status  String

  title String
  brief String @db.Text

  audioUrl        String?
  durationSeconds Int?
  externalRef     String?
  error           String? @db.Text

  requestedAt DateTime
  completedAt DateTime?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, day])
  @@index([ownerId, requestedAt])
}
