// Persistence mirrors the aggregates, not the screens. Everything time-like is a DateTime here
// and an epoch-millisecond `Instant` in the domain; src/mappers is the only place that converts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // Prisma 7 takes the connection string from prisma.config.ts (CLI) and from the driver
  // adapter passed to `new PrismaClient()` (runtime). Nothing secret lives in this file.
  provider = "postgresql"
}

model OpenLoop {
  id        String @id
  sourceKey String @unique

  kind    String
  title   String
  summary String @db.Text

  provider   String
  externalId String
  threadRef  String?
  url        String?
  channel    String?
  occurredAt DateTime

  counterpartyName       String?
  counterpartyHandle     String?
  counterpartyEmail      String?
  counterpartyImportance String?

  dueAt           DateTime?
  promisedFor     DateTime?
  estimateMinutes Int
  priority        Int
  confidence      Float

  manualState  String?
  manualReason String?
  snoozedUntil DateTime?

  createdAt     DateTime
  updatedAt     DateTime
  lastCheckedAt DateTime?

  criteria   Criterion[]
  evidence   EvidenceRecord[]
  planBlocks PlanBlock[]
  events     LoopEventLog[]

  @@index([updatedAt])
  @@index([provider])
}

model Criterion {
  id       String  @id
  loopId   String
  role     String
  optional Boolean @default(false)
  probe    Json

  loop     OpenLoop         @relation(fields: [loopId], references: [id], onDelete: Cascade)
  evidence EvidenceRecord[]

  @@index([loopId])
}

model EvidenceRecord {
  id          String   @id @default(uuid())
  loopId      String
  criterionId String
  verdict     String
  observedAt  DateTime
  summary     String   @db.Text
  url         String?

  loop      OpenLoop  @relation(fields: [loopId], references: [id], onDelete: Cascade)
  criterion Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  /// Two identical observations of the same criterion at the same instant are the same
  /// observation. Making that a database fact lets the aggregate be written with an idempotent
  /// `createMany` instead of a read-then-append inside an interactive transaction.
  @@unique([criterionId, observedAt, verdict])
  @@index([loopId, observedAt])
}

model DailyPlan {
  id          String   @id
  day         String   @unique
  dayStartAt  DateTime
  startMinute Int
  endMinute   Int
  manualOrder Json
  generatedAt DateTime

  blocks PlanBlock[]
}

model PlanBlock {
  id          String   @id @default(uuid())
  planId      String
  loopId      String
  startAt     DateTime
  endAt       DateTime
  position    Int
  disposition String
  slipCount   Int      @default(0)
  pinned      Boolean  @default(false)

  plan DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  loop OpenLoop  @relation(fields: [loopId], references: [id], onDelete: Cascade)

  @@unique([planId, loopId])
  @@index([planId, startAt])
}

model Integration {
  id                 String    @id
  provider           String    @unique
  mode               String
  status             String
  accountLabel       String?
  externalAccountRef String?
  scopes             String[]
  lastSyncedAt       DateTime?
  lastError          String?
  connectedAt        DateTime?
}

model SyncCursor {
  provider String   @id
  at       DateTime
}

model RawSignal {
  id             String    @id @default(uuid())
  provider       String
  externalId     String
  kind           String
  title          String    @db.Text
  body           String    @db.Text
  author         Json
  participants   Json
  occurredAt     DateTime
  threadRef      String?
  url            String?
  channel        String?
  isDirectedAtMe Boolean   @default(false)
  metadata       Json?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  @@unique([provider, externalId])
  @@index([processedAt, occurredAt])
  @@index([kind, occurredAt])
}

model LoopEventLog {
  id      String   @id @default(uuid())
  loopId  String
  type    String
  at      DateTime
  payload Json

  loop OpenLoop @relation(fields: [loopId], references: [id], onDelete: Cascade)

  @@index([loopId, at])
}

/// Local mode has no API keys, so the AI client answers probes out of band. A tick leaves the
/// question here; the agent posts the answer back and the next tick consumes it exactly once.
model ProbeTask {
  id          String    @id @default(uuid())
  loopId      String
  criterionId String
  probe       Json
  describedAs String    @db.Text
  requestedAt DateTime  @default(now())
  answeredAt  DateTime?
  consumedAt  DateTime?
  verdict     String?
  summary     String?   @db.Text
  url         String?

  @@index([criterionId, answeredAt])
  @@index([answeredAt, consumedAt])
}

/// The only account model this app has. Credentials never live in environment variables, so a
/// password change is a row update rather than a redeploy. `passwordHash` is scrypt output with
/// its own salt and parameters encoded in the string; nothing here is reversible.
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Bumping this invalidates every token issued before the change, which is what makes
  /// "log out everywhere" and a password reset the same operation.
  tokenVersion Int      @default(0)
}

/// One row, always. Settings that a person changes from the app belong in the database rather
/// than in environment variables — changing a schedule should not be a redeploy. The env vars
/// remain the seed for the first row and nothing more.
model AppSettings {
  id String @id @default("singleton")

  /// Cron expressions, read in OPEN_LOOPS_TIMEZONE.
  sweepCron   String
  podcastCron String

  podcastEnabled     Boolean @default(false)
  podcastLength      String  @default("default")
  podcastHostVoiceId String?
  podcastGuestVoiceId String?

  updatedAt DateTime @updatedAt
}

/// One episode per day. `brief` is the text the generator was given, kept because a disappointing
/// episode is almost always a disappointing brief.
model PodcastEpisode {
  id     String @id @default(uuid())
  day    String @unique
  status String

  title String
  brief String @db.Text

  audioUrl        String?
  durationSeconds Int?
  externalRef     String?
  error           String? @db.Text

  requestedAt DateTime
  completedAt DateTime?

  @@index([requestedAt])
}
