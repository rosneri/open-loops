// Persistence mirrors the aggregates, not the screens. Everything time-like is a DateTime here
// and an epoch-millisecond `Instant` in the domain; src/mappers is the only place that converts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // Prisma 7 takes the connection string from prisma.config.ts (CLI) and from the driver
  // adapter passed to `new PrismaClient()` (runtime). Nothing secret lives in this file.
  provider = "postgresql"
}

model OpenLoop {
  id        String @id
  /// Every root table carries its owner. The child tables below do not: they are reachable
  /// only through a parent that already has one, and a second copy could disagree with it.
  ownerId   String
  sourceKey String

  kind    String
  title   String
  summary String @db.Text

  provider   String
  externalId String
  threadRef  String?
  url        String?
  channel    String?
  occurredAt DateTime

  counterpartyName       String?
  counterpartyHandle     String?
  counterpartyEmail      String?
  counterpartyImportance String?

  dueAt           DateTime?
  promisedFor     DateTime?
  estimateMinutes Int
  priority        Int
  confidence      Float

  manualState  String?
  manualReason String?
  snoozedUntil DateTime?

  createdAt     DateTime
  updatedAt     DateTime
  lastCheckedAt DateTime?

  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  criteria   Criterion[]
  evidence   EvidenceRecord[]
  planBlocks PlanBlock[]
  events     LoopEventLog[]

  @@unique([ownerId, sourceKey])
  @@index([ownerId, updatedAt])
  @@index([ownerId, provider])
}

model Criterion {
  id       String  @id
  loopId   String
  role     String
  optional Boolean @default(false)
  probe    Json

  loop     OpenLoop         @relation(fields: [loopId], references: [id], onDelete: Cascade)
  evidence EvidenceRecord[]

  @@index([loopId])
}

model EvidenceRecord {
  id          String   @id @default(uuid())
  loopId      String
  criterionId String
  verdict     String
  observedAt  DateTime
  summary     String   @db.Text
  url         String?

  loop      OpenLoop  @relation(fields: [loopId], references: [id], onDelete: Cascade)
  criterion Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  /// Two identical observations of the same criterion at the same instant are the same
  /// observation. Making that a database fact lets the aggregate be written with an idempotent
  /// `createMany` instead of a read-then-append inside an interactive transaction.
  @@unique([criterionId, observedAt, verdict])
  @@index([loopId, observedAt])
}

model DailyPlan {
  id          String   @id
  ownerId     String
  day         String
  dayStartAt  DateTime
  startMinute Int
  endMinute   Int
  manualOrder Json
  generatedAt DateTime

  owner  User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  blocks PlanBlock[]

  @@unique([ownerId, day])
}

model PlanBlock {
  id          String   @id @default(uuid())
  planId      String
  loopId      String
  startAt     DateTime
  endAt       DateTime
  position    Int
  disposition String
  slipCount   Int      @default(0)
  pinned      Boolean  @default(false)

  plan DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  loop OpenLoop  @relation(fields: [loopId], references: [id], onDelete: Cascade)

  @@unique([planId, loopId])
  @@index([planId, startAt])
}

model Integration {
  id                 String    @id
  ownerId            String
  provider           String
  mode               String
  status             String
  accountLabel       String?
  externalAccountRef String?
  scopes             String[]
  lastSyncedAt       DateTime?
  lastError          String?
  connectedAt        DateTime?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, provider])
}

model SyncCursor {
  ownerId  String
  provider String
  at       DateTime

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([ownerId, provider])
}

model RawSignal {
  id             String    @id @default(uuid())
  ownerId        String
  provider       String
  externalId     String
  kind           String
  title          String    @db.Text
  body           String    @db.Text
  author         Json
  participants   Json
  occurredAt     DateTime
  threadRef      String?
  url            String?
  channel        String?
  isDirectedAtMe Boolean   @default(false)
  metadata       Json?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, provider, externalId])
  @@index([ownerId, processedAt, occurredAt])
  @@index([ownerId, kind, occurredAt])
}

model LoopEventLog {
  id      String   @id @default(uuid())
  loopId  String
  type    String
  at      DateTime
  payload Json

  loop OpenLoop @relation(fields: [loopId], references: [id], onDelete: Cascade)

  @@index([loopId, at])
}

/// Local mode has no API keys, so the AI client answers probes out of band. A tick leaves the
/// question here; the agent posts the answer back and the next tick consumes it exactly once.
model ProbeTask {
  id          String    @id @default(uuid())
  ownerId     String
  loopId      String
  criterionId String
  probe       Json
  describedAs String    @db.Text
  requestedAt DateTime  @default(now())
  answeredAt  DateTime?
  consumedAt  DateTime?
  verdict     String?
  summary     String?   @db.Text
  url         String?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, criterionId, answeredAt])
  @@index([ownerId, answeredAt, consumedAt])
}

/// The only account model this app has. Credentials never live in environment variables, so a
/// password change is a row update rather than a redeploy. `passwordHash` is scrypt output with
/// its own salt and parameters encoded in the string; nothing here is reversible.
model User {
  id           String   @id @default(uuid())
  /// The address this person signs in with. It was called `username` until every account on
  /// every install turned out to hold an email address anyway, and a reset that cannot reach
  /// anybody is not a reset — the column says what the value has always been.
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Bumping this invalidates every token issued before the change, which is what makes
  /// "log out everywhere" and a password reset the same operation.
  tokenVersion Int      @default(0)

  /// The identity Composio scopes this person's connected accounts to. Stored rather than
  /// derived from the id: the account that connected Slack and GitHub before this app had
  /// accounts keyed them to OPEN_LOOPS_USER_ID, and it keeps them by claiming that value once.
  /// Unique, so two people can never end up sharing one set of upstream OAuth connections.
  composioUserId String? @unique

  /// The names this person answers to across providers — the addresses and usernames that make
  /// a message "to me" rather than about someone else. Per account, because a shared list would
  /// attribute one person's mail to everybody.
  handles String[] @default([])

  settings     UserSettings?
  loops        OpenLoop[]
  plans        DailyPlan[]
  integrations Integration[]
  cursors      SyncCursor[]
  signals      RawSignal[]
  probeTasks   ProbeTask[]
  pluginRecords PluginRecord[]
  schedules    ScheduleEntry[]
  tickRuns     TickRun[]
}

/// One row per person. Settings that someone changes from the app belong in the database rather
/// than in environment variables — changing a schedule should not be a redeploy. The env vars
/// remain the seed for a new row and nothing more.
model UserSettings {
  id     String @id @default(uuid())
  userId String @unique

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One episode per day. `brief` is the text the generator was given, kept because a disappointing
/// episode is almost always a disappointing brief.

/// A plugin's own rows, without a migration each time. Namespaced by plugin and by owner, and
/// reached only through a store that was built knowing both — the same trick the repositories
/// play for tenancy, applied to features. Anything the core reasons about still earns a table.
model PluginRecord {
  ownerId    String
  pluginId   String
  collection String
  key        String
  value      Json
  updatedAt  DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([ownerId, pluginId, collection, key])
  @@index([ownerId, pluginId, collection])
}

/// One row per account per kind of scheduled work. This used to be two columns named after the
/// two things the app happened to do, which meant a third kind of work needed a migration, a DTO
/// field and a branch in the scheduler. The kinds are registered now; this is only where the
/// expressions live.
model ScheduleEntry {
  ownerId String
  kind    String
  /// A cron expression, read in OPEN_LOOPS_TIMEZONE.
  cron    String
  enabled Boolean @default(true)

  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([ownerId, kind])
}

/// One sweep, kept so a person can ask what happened rather than guess. The counts live in the
/// report the API already returns; the entries are what those counts were made of — which loop,
/// from which signal, and which upstream call — because a number is not something you can debug.
model TickRun {
  id         String   @id
  ownerId    String
  startedAt  DateTime
  finishedAt DateTime
  /// The TickReportDto exactly as the API returned it, plus the per-entry detail.
  report     Json
  /// Denormalised from the report so the list can be read without parsing every row.
  failed     Boolean  @default(false)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, startedAt])
}
