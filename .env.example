DATABASE_URL="postgresql://USER:PASSWORD@localhost:5439/openloops?schema=public"
PORT=4455
OPEN_LOOPS_MODE="HOSTED"
OPEN_LOOPS_TIMEZONE="Asia/Jerusalem"
# Seeds the *first* account's identity and nothing more: the Composio user its connected apps
# hang off, and the handles that make a signal "to me". Both move onto the account row the first
# time it is used, so a second account never shares the first one's OAuth connections and
# handles are edited on the Settings screen rather than redeployed.
OPEN_LOOPS_USER_ID="neri"
OPEN_LOOPS_HANDLES="neri.coder@gmail.com"
# Who may call this API from a browser. A CORS allowlist, and "*" is a fine answer for it.
WEB_ORIGIN="*"

# This deployment's own public address, with no trailing slash. Leave it unset locally, where
# http://localhost:$PORT is correct. Set it on anything hosted: the OAuth callback handed to
# Composio is built from it, and a browser that finishes consent follows it back here — so an
# unset value on a hosted deployment sends every user to their own machine.
#   OPEN_LOOPS_SITE_URL="https://open-loops.example.com"
OPEN_LOOPS_SITE_URL=""

# Signs the session cookie. At least 32 characters, and changing it ends every session.
#   openssl rand -base64 48
AUTH_JWT_SECRET=""
# How long a session lasts before the user signs in again. Default is a week.
AUTH_SESSION_TTL_HOURS=168
# Opens the signup form to whoever holds this code. Unset — the default — means there is no
# registration route at all and accounts are made with `bun run create-user`. At least 6
# characters, and the route is rate limited — but make it long anyway unless the deployment is
# on a LAN. Treat it as a password shared by everyone you invite, and it is case-sensitive.
#   openssl rand -base64 24
# AUTH_SIGNUP_INVITE_CODE=""
# Shared secret for the callers that have no browser: the local agent on /api/agent/*, and
# /api/tick. Optional in LOCAL mode, required in HOSTED, where CRON_SECRET also works and is
# what Vercel Cron sends on its own requests.
# OPEN_LOOPS_AGENT_TOKEN=""
DAY_START_MINUTE=540
DAY_END_MINUTE=1080
# Seed the schedule rows on a fresh database. After that the Settings screen owns every
# schedule, and these are ignored — changing a schedule should not be a redeploy.
TICK_CRON="0 * * * *"
# Read by plugins/podcast rather than by the app, like every PODCAST_/STUDIO_/ELEVENLABS_ variable.
PODCAST_CRON="0 7 * * *"
TICK_ON_BOOT=false

# Who does the thinking first. Independent of OPEN_LOOPS_MODE, which only decides how data arrives.
#   claude-code -> plugins/reasoning-claude-code: the Claude Code already logged in here. No key.
#   anthropic / openai -> plugins/reasoning-ai-sdk: a keyed provider through the Vercel AI SDK.
# Leave unset and LOCAL mode picks claude-code, hosted picks anthropic. Every other registered
# provider that can run here sits behind the first as a fallback.
AI_PROVIDER="claude-code"
AI_MODEL="sonnet"
# CLAUDE_CODE_BIN="claude"
# ANTHROPIC_API_KEY=""

# The day, read aloud. `studio` is podcastfy's pipeline in this process: the configured model
# writes a two-speaker script and the free Edge voices read it. No key, no cost.
PODCAST_PROVIDER="studio"
# STUDIO_HOST_VOICE="en-US-AndrewNeural"
# STUDIO_GUEST_VOICE="en-US-AvaNeural"

# Only for PODCAST_PROVIDER="elevenlabs".
# ELEVENLABS_API_KEY=""

# The scheduler. Nothing schedules itself, so an always-on machine runs apps/scheduler and calls
# the deployment when each account's cron is due. The token must match the API's.
OPEN_LOOPS_API_URL="http://localhost:4455"
# OPEN_LOOPS_AGENT_TOKEN=""
SCHEDULE_REFRESH_MS=300000

# Set automatically when a Vercel Blob store is attached. Episodes need somewhere to live that
# outlives the request that made them.
# BLOB_READ_WRITE_TOKEN=""
