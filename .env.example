DATABASE_URL="postgresql://USER:PASSWORD@localhost:5439/openloops?schema=public"
PORT=4455
OPEN_LOOPS_MODE="HOSTED"
OPEN_LOOPS_TIMEZONE="Asia/Jerusalem"
OPEN_LOOPS_USER_ID="neri"
OPEN_LOOPS_HANDLES="neri.coder@gmail.com"
WEB_ORIGIN="*"

# Signs the session cookie. At least 32 characters, and changing it ends every session.
#   openssl rand -base64 48
AUTH_JWT_SECRET=""
# How long a session lasts before the user signs in again. Default is a week.
AUTH_SESSION_TTL_HOURS=168
# Shared secret for the callers that have no browser: the local agent on /api/agent/*, and
# /api/tick. Optional in LOCAL mode, required in HOSTED, where CRON_SECRET also works and is
# what Vercel Cron sends on its own requests.
# OPEN_LOOPS_AGENT_TOKEN=""
DAY_START_MINUTE=540
DAY_END_MINUTE=1080
# Seeds the settings row on a fresh database. After that the Settings screen owns both
# schedules, and these are ignored — changing a schedule should not be a redeploy.
TICK_CRON="0 * * * *"
PODCAST_CRON="0 7 * * *"
TICK_ON_BOOT=false

# Who does the thinking. Independent of OPEN_LOOPS_MODE, which only decides how data arrives.
#   claude-code -> drives the Claude Code already logged in on this machine. No API key.
#   anthropic / openai -> a keyed provider through the Vercel AI SDK.
# Leave unset and LOCAL mode picks claude-code, hosted picks anthropic.
AI_PROVIDER="claude-code"
AI_MODEL="sonnet"
# CLAUDE_CODE_BIN="claude"
# ANTHROPIC_API_KEY=""

# The day, read aloud. ElevenLabs Studio writes and records a two-host conversation from the
# brief; without a key the podcast simply stays off and says so in Settings.
# ELEVENLABS_API_KEY=""
# ELEVENLABS_HOST_VOICE_ID=""
# ELEVENLABS_GUEST_VOICE_ID=""

# Set automatically when a Vercel Blob store is attached. Episodes need somewhere to live that
# outlives the request that made them.
# BLOB_READ_WRITE_TOKEN=""
