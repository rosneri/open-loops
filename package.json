{
  "name": "open-loops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "libs/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "setup": "bun install && bun run db:up && bun run db:generate && bun run db:push",
    "dev": "moon run api:dev web:dev",
    "dev:api": "moon run api:dev",
    "dev:web": "moon run web:dev",
    "build": "moon run :build",
    "typecheck": "moon run :typecheck",
    "test": "moon run :test",
    "lint": "moon run :lint",
    "check": "moon check --all",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "bun run --cwd libs/persistence db:generate",
    "db:push": "bun run --cwd libs/persistence db:push",
    "db:studio": "bun run --cwd libs/persistence db:studio",
    "tick": "bun run --cwd apps/api tick",
    "create-user": "bun apps/api/src/create-user.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.10.1",
    "prettier": "^3.6.2",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@nestjs/core": "^11.2.3",
    "@nestjs/common": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "@open-loops/api": "workspace:*"
  }
}
